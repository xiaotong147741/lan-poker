  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1f5c3d, stop:1 #143c28);
}
QLabel {
    color: #f0f0f0;
}
QLabel#info {
    font-size: 15px;
    font-weight: bold;
    color: #ffd166;
}
QLabel#seat0, QLabel#seat1, QLabel#seat2, QLabel#seat3, QLabel#seat4,
QLabel#seat5, QLabel#seat6, QLabel#seat7, QLabel#seat8 {
    background-color: rgba(0, 0, 0, 110);
    border-radius: 8px;
    padding: 3px 8px;
    font-weight: bold;
}
QLabel#b0, QLabel#b1, QLabel#b2, QLabel#b3, QLabel#b4,
QLabel#hole1, QLabel#hole2,
QLabel#h0a, QLabel#h0b, QLabel#h1a, QLabel#h1b, QLabel#h2a, QLabel#h2b,
QLabel#h3a, QLabel#h3b, QLabel#h4a, QLabel#h4b, QLabel#h5a, QLabel#h5b,
QLabel#h6a, QLabel#h6b, QLabel#h7a, QLabel#h7b, QLabel#h8a, QLabel#h8b {
    background-color: #fdfdfd;
    color: #222222;
    border: 1px solid #bbbbbb;
    border-radius: 6px;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}
QLabel#handrank0, QLabel#handrank1, QLabel#handrank2, QLabel#handrank3,
QLabel#handrank4, QLabel#handrank5, QLabel#handrank6, QLabel#handrank7,
QLabel#handrank8 {
    color: #ffd166;
    font-weight: bold;
}
QLabel#mySeat, QLabel#potNum, QLabel#curNum, QLabel#myChips, QLabel#myBet {
    color: #ffd166;
    font-weight: bold;
}
QPushButton#fold {
    background-color: #c0392b; color: white; border-radius: 6px; padding: 4px 10px;
}
QPushButton#fold:hover { background-color: #e74c3c; }
QPushButton#check {
    background-color: #7f8c8d; color: white; border-radius: 6px; padding: 4px 10px;
}
QPushButton#check:hover { background-color: #95a5a6; }
QPushButton#call {
    background-color: #2980b9; color: white; border-radius: 6px; padding: 4px 10px;
}
QPushButton#call:hover { background-color: #3498db; }
QPushButton#raise {
    background-color: #e67e22; color: white; border-radius: 6px; padding: 4px 10px;
}
QPushButton#raise:hover { background-color: #f39c12; }
QPushButton:disabled {
    background-color: #555555; color: #999999;
}
QSpinBox#raiseTo {
    background-color: #ffffff; border-radius: 4px; padding: 2px;
}</string>
